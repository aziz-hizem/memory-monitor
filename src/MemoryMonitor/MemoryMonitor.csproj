<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MemoryMonitor</AssemblyName>
    <RootNamespace>MemoryMonitor</RootNamespace>

    <!-- Keep the footprint as small as possible: no server GC (it reserves
         a heap segment per core), no tiered PGO background thread churn,
         no globalization data we don't need. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Framework-dependent (not self-contained): the app shares the
         already-installed .NET runtime DLLs with every other .NET process
         on the machine instead of loading a private copy of its own.
         Measured: ~10MB of memory uniquely owned by this process vs.
         ~110MB when self-contained/single-file. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
